# LANDVEX Opportunity Engine — deployment configuration.
# Copy to .env and fill in. Never commit the filled-in .env (see .gitignore).

# --- API auth & tenancy -----------------------------------------------------
# Comma-separated keys: key:tenant:role[:plan[:addon|addon]]
# Open mode (no auth) if left empty — do NOT leave empty in production.
LANDVEX_API_KEYS=
# Optional JWT bearer auth alongside API keys (HS256).
LANDVEX_JWT_SECRET=

# --- Persistence ------------------------------------------------------------
# SQLite path (default) or "off". Use Postgres in production via LANDVEX_PG_DSN.
LANDVEX_DB=/data/landvex.db
# Aurora / Postgres DSN (set LANDVEX_DB=off when using this):
# LANDVEX_PG_DSN=postgresql://landvex:changeme@db:5432/landvex

# --- Runtime ----------------------------------------------------------------
LANDVEX_PORT=8000
WEB_CONCURRENCY=2
APP_BIND=127.0.0.1:8000
LANDVEX_AUDIT_LOG=/var/log/landvex/audit.jsonl
# CORS: comma-separated allowed origins (only needed if the frontend is served
# from a different origin than the API). Same-origin deploys can leave this empty.
LANDVEX_CORS_ORIGINS=

# --- Live data sources (all optional; degrade honestly to mock when unset) ---
LANDVEX_SCB_BASE=https://api.scb.se/OV0104/v1/doris/sv/ssd
# LANDVEX_KOLADA_URL=https://api.kolada.se/v2
# LANDVEX_SVK_URL=https://www.svk.se/services/controlroom
# LANDVEX_PERMITS_URL=
# LANDVEX_PLACES_URL=
# LANDVEX_PROGRAMS_URL=

# --- AAMOS / quiXzoom integration (optional) --------------------------------
# AAMOS_CORE_URL=http://127.0.0.1:3100
# AAMOS_QUIXZOOM_PATH=/api/qz/missions
# AAMOS_TOKEN=            # service-account token from AAMOS admin (never forge)
# Direct quiXzoom (:3209) instead of via Core:
# LANDVEX_QUIXZOOM_URL=http://127.0.0.1:3209

# --- docker-compose postgres profile ----------------------------------------
PGUSER=landvex
PGPASSWORD=changeme
PGDATABASE=landvex
