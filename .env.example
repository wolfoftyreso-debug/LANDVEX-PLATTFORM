# LANDVEX Opportunity Engine — environment.
# Generated by `python3 -m scripts.preflight --template`.
# Every line below comes from engine/deployment.ENVIRONMENT, which
# a test holds against what the code actually reads.
#
# Secrets are left EMPTY on purpose. Keep them in a secret store
# (AWS Secrets Manager) and inject them as `secrets` in the task
# definition — a value in a file gets committed sooner or later.

# ────────────────────────────────────────────────────────────────────
# REQUIRED — without these the system starts unsafely or loses data
# ────────────────────────────────────────────────────────────────────

# Comma-separated key:tenant:role[:plan[:addons]] entries.
#   If unset: THE API RUNS OPEN. Every request is treated as an admin of
#   tenant 'dev' with the enterprise plan. Acceptable on a laptop, never
#   on a reachable host.
#   SECRET — inject from a secret store.
LANDVEX_API_KEYS=

# SQLite file for reports, profiles, decisions, monitors and the
# monthly quota.
#   If unset: Defaults to landvex.db in the working directory — which is
#   ephemeral in a container. Every commitment, profile and quota count
#   is lost on restart. Set a path on a mounted volume, or 'off' to run
#   stateless deliberately.
LANDVEX_DB=/data/landvex.db

# ────────────────────────────────────────────────────────────────────
# RECOMMENDED — it runs without them, but worse or less honestly
# ────────────────────────────────────────────────────────────────────

# Path for the JSON-lines audit log.
#   If unset: Defaults to landvex-audit.log in the working directory.
#   Set 'off' to disable, or a path outside a read-only /app.
LANDVEX_AUDIT_LOG=/var/log/landvex/audit.jsonl

# Interface to bind.
#   If unset: Defaults to 0.0.0.0, which is right behind a load balancer
#   and wrong on a laptop. Set 127.0.0.1 for local work.
LANDVEX_HOST=0.0.0.0

# HS256 secret for bearer tokens (AAMOS standard).
#   If unset: JWT authentication is disabled; a Bearer token is rejected
#   with 401. API keys still work.
#   SECRET — inject from a secret store.
LANDVEX_JWT_SECRET=

# Kolada API base — municipal KPIs and livability.
#   If unset: Care supply, school outcomes and crime index fall back to
#   mock.
LANDVEX_KOLADA_URL=https://api.kolada.se/v2

# Set to 0 to disable every live source and run on mock only.
#   If unset: Live sources are attempted. That is right in production
#   and wrong in CI, where it makes the build depend on third-party
#   uptime.
LANDVEX_LIVE=1

# PostgreSQL connection string. Replaces SQLite in production (Aurora
# + PostGIS).
#   If unset: SQLite is used. One file, one writer: fine for a single
#   task, wrong the moment a second replica starts, because the two
#   cannot share it.
#   SECRET — inject from a secret store.
LANDVEX_PG_DSN=

# Port the API listens on.
#   If unset: Defaults to 8000. Fine behind a load balancer that knows
#   it.
LANDVEX_PORT=8000

# What a failed preflight costs at container start: 'strict' refuses
# to serve, 'warn' logs and serves, 'off' skips the check.
#   If unset: Defaults to 'warn': the container starts and the reasons
#   are in the first lines of the log. Set 'strict' in production so a
#   misconfigured task never reaches the load balancer.
LANDVEX_PREFLIGHT=strict

# Statistics Sweden PxWeb base URL.
#   If unset: Population, income and density fall back to mock, labelled
#   mock, and data_coverage drops accordingly.
LANDVEX_SCB_BASE=https://api.scb.se/OV0104/v1/doris/en/ssd

# Gunicorn worker processes in one container.
#   If unset: The image defaults to 2. Two workers on one SQLite file is
#   two writers on one file — set it to 1, or move to PostgreSQL.
WEB_CONCURRENCY=2

# ────────────────────────────────────────────────────────────────────
# OPTIONAL — a connection to something, not a precondition
# ────────────────────────────────────────────────────────────────────

# AAMOS API key.
#   If unset: Requests go unauthenticated.
#   SECRET — inject from a secret store.
AAMOS_API_KEY=

# Custom AAMOS auth header name.
#   If unset: Standard Authorization / X-API-Key are used.
AAMOS_AUTH_HEADER=

# Value for that custom header.
#   If unset: No custom header is sent.
#   SECRET — inject from a secret store.
AAMOS_AUTH_VALUE=

# AAMOS Capability Platform base URL.
#   If unset: Platform status, agents and cognition report not-connected
#   honestly, and service self-registration is skipped.
AAMOS_CORE_URL=

# quiXzoom path inside AAMOS.
#   If unset: The documented path is used.
AAMOS_QUIXZOOM_PATH=

# AAMOS request timeout in seconds.
#   If unset: The documented default timeout is used.
AAMOS_TIMEOUT=

# AAMOS bearer token — a service-account token issued by AAMOS admin.
# Never mint or forge one: a token this side signs itself proves
# nothing about who is calling.
#   If unset: Requests go unauthenticated, and AAMOS-backed endpoints
#   report not-connected honestly rather than failing.
#   SECRET — inject from a secret store.
AAMOS_TOKEN=

# Sensor.Community (citizen air sensors). No key.
#   If unset: Air quality rests on OpenAQ alone, and a single network
#   cannot corroborate itself.
LANDVEX_AIR_COMMUNITY_URL=https://data.sensor.community

# OpenAQ API key (free).
#   If unset: No call is made even with the URL set.
#   SECRET — inject from a secret store.
LANDVEX_AIR_KEY=

# OpenAQ v3 base.
#   If unset: Air quality is not measured.
LANDVEX_AIR_URL=https://api.openaq.org

# BarentsWatch client id (register an account).
#   If unset: No token is requested and the source refuses — 'not
#   applied for' is a different state from 'down', and it is fixed by an
#   application rather than by a restart.
LANDVEX_AIS_NO_CLIENT_ID=

# BarentsWatch client secret.
#   If unset: As above — the credential exchange cannot be made.
#   SECRET — inject from a secret store.
LANDVEX_AIS_NO_SECRET=

# BarentsWatch OAuth2 token endpoint.
#   If unset: The documented default endpoint is used.
LANDVEX_AIS_NO_TOKEN_URL=https://id.barentswatch.no/connect/token

# BarentsWatch AIS (Norwegian coastal waters).
#   If unset: Vessel traffic rests on Fintraffic alone.
LANDVEX_AIS_NO_URL=https://live.ais.barentswatch.no

# Digitraffic marine AIS. No key.
#   If unset: Vessel movements are not read.
LANDVEX_AIS_URL=https://meri.digitraffic.fi

# Single key used BY scripts/readiness_check.py to call a running
# server. Not read by the server itself — that one is
# LANDVEX_API_KEYS, plural.
#   If unset: The readiness check calls unauthenticated, which only
#   works against a server running in open mode.
#   SECRET — inject from a secret store.
LANDVEX_API_KEY=

# US Census CBP base URL.
#   If unset: The documented base is used.
LANDVEX_CENSUS_BASE=

# US Census API key. Optional even upstream — Census allows anonymous
# calls at a lower rate.
#   If unset: Calls go unauthenticated and are rate-limited harder.
#   SECRET — inject from a secret store.
LANDVEX_CENSUS_KEY=

# CBP survey year.
#   If unset: The documented default year is used.
LANDVEX_CENSUS_YEAR=

# Comma-separated origins allowed to call the API from a browser.
#   If unset: CORS middleware is not installed at all. Correct when the
#   frontend is served from the same origin; breaks a separate frontend
#   domain.
LANDVEX_CORS_ORIGINS=https://app.landvex.io

# Statistics Denmark base.
#   If unset: The documented base is used.
LANDVEX_DST_BASE=

# DST establishments table.
#   If unset: The documented table id is used.
LANDVEX_DST_ESTAB_TABLE=

# Bidding zone EIC code for the ENTSO-E probe.
#   If unset: The probe uses SE3.
LANDVEX_ENTSOE_AREA=

# Start of the ENTSO-E probe window (yyyymmddHHMM).
#   If unset: The probe uses a documented default window.
LANDVEX_ENTSOE_FROM=

# End of the ENTSO-E probe window (yyyymmddHHMM).
#   If unset: The probe uses a documented default window.
LANDVEX_ENTSOE_TO=

# ENTSO-E API token (free, but applied for by email).
#   If unset: No call is made even with the URL set — 'not applied for'
#   is a different state from 'down'.
#   SECRET — inject from a secret store.
LANDVEX_ENTSOE_TOKEN=

# ENTSO-E Transparency Platform base.
#   If unset: Grid telemetry rests on Svenska kraftnät alone, although
#   the sensor catalogue already names ENTSO-E as an operator.
LANDVEX_ENTSOE_URL=https://web-api.tp.entsoe.eu

# Start of the EO probe window.
#   If unset: The probe uses a documented default window.
LANDVEX_EO_FROM=

# NASA CMR granule search — Landsat coverage. No key.
#   If unset: Satellite coverage rests on Copernicus alone, so a cloudy
#   Sentinel pass cannot be checked against another constellation.
LANDVEX_EO_NASA_URL=https://cmr.earthdata.nasa.gov

# End of the EO probe window.
#   If unset: The probe uses a documented default window.
LANDVEX_EO_TO=

# Copernicus STAC search endpoint.
#   If unset: Satellite coverage cannot be checked, so the platform
#   cannot tell 'nothing changed' from 'nothing was observed'.
LANDVEX_EO_URL=

# Eurostat API base URL.
#   If unset: The documented base is used.
LANDVEX_EUROSTAT_BASE=

# Override the Eurostat dataset id.
#   If unset: The documented default dataset is used.
LANDVEX_EUROSTAT_DATASET=

# Eurostat base URL for EU-wide livability signals.
#   If unset: EU markets use mock for the signals Eurostat would
#   provide.
LANDVEX_EUROSTAT_LIVE=

# Administrative boundary service.
#   If unset: Region lookup uses the built-in table, which covers the
#   markets listed in /v1/markets.
LANDVEX_GEO_URL=

# Station id for the hydro probe.
#   If unset: The probe uses a documented default.
LANDVEX_HYDRO_STATION=

# SMHI hydrology base.
#   If unset: Water level and discharge are not measured.
LANDVEX_HYDRO_URL=

# Site id for the USGS water probe.
#   If unset: The probe uses a documented default gauge.
LANDVEX_HYDRO_US_STATION=

# USGS Water Services (NWIS). No key.
#   If unset: Water level rests on SMHI alone.
LANDVEX_HYDRO_US_URL=https://waterservices.usgs.gov

# Open-Meteo base. No key.
#   If unset: Weather is read only where SMHI (SE) or NWS (US) reaches;
#   the rest of the world has none.
LANDVEX_METEO_URL=https://api.open-meteo.com

# Stream id the meter probe reads.
#   If unset: The meter probe reports 'not configured'.
LANDVEX_METER_STREAM=

# Owner-supplied sensor feed base (building meters, district heating,
# water, waste).
#   If unset: Every owner-supplied stream is unavailable.
LANDVEX_METER_URL=

# Switch on news harvesting (RSS/Atom, no key). The feed addresses are
# data in engine/news.FEEDS.
#   If unset: No news is read, and every risk category that only
#   reporting could observe stays in 'monitoring'.
LANDVEX_NEWS_ON=on

# Switch on every KEYLESS open source at once, using each one's
# documented default endpoint.
#   If unset: Nothing is switched on. Sources still work one at a time
#   via their own variable — this only saves setting twenty of them.
#   Sources that need a key are never enabled by it.
LANDVEX_OPEN_DATA=on

# Overpass endpoint (OpenStreetMap). No key.
#   If unset: Competing supply stays mock in every market — the single
#   largest gap in coverage, since competition carries the supply side
#   of every decision card.
LANDVEX_OSM_URL=https://overpass-api.de/api/interpreter

# Switch on US municipal building-permit harvesting (Socrata, no key).
# The seven city registers are data in
# engine/harvest._SOCRATA_PERMITS.
#   If unset: The PLANNED half of the contradiction index stays
#   simulated in every market, so /v1/analysis reports no contradictions
#   at all — a real observed side compared against simulated paperwork
#   is refused, not scored.
LANDVEX_PERMITS_ON=on

# Building permits and detail plans feed.
#   If unset: Permit signals are mock; the brief cannot check a
#   structure change against a permit.
LANDVEX_PERMITS_URL=

# Places / competition source.
#   If unset: Competition pressure and provider gap are mock.
LANDVEX_PLACES_URL=

# Support-programme feed.
#   If unset: Programme matching is mock.
LANDVEX_PROGRAMS_URL=

# Header name for the quiXzoom key.
#   If unset: The documented default header is used.
LANDVEX_QUIXZOOM_AUTH_HEADER=

# quiXzoom API key.
#   If unset: Requests go unauthenticated and will likely be refused.
#   SECRET — inject from a secret store.
LANDVEX_QUIXZOOM_KEY=

# Path quiXzoom accepts a mission ORDER on. Reading missions and
# ordering one are different endpoints.
#   If unset: The documented default path is used. Ordering still
#   refuses entirely unless LANDVEX_QUIXZOOM_URL is set — no mission id
#   is ever invented.
LANDVEX_QUIXZOOM_MISSION_PATH=/api/missions

# Observations path override.
#   If unset: The documented path is used.
LANDVEX_QUIXZOOM_PATH=

# Direct quiXzoom observations endpoint.
#   If unset: Field observations come through AAMOS if that is
#   configured, otherwise not at all.
LANDVEX_QUIXZOOM_URL=

# Global requests per minute per key.
#   If unset: Defaults to 300. Per-plan limits still apply on top.
LANDVEX_RATE_LIMIT=300

# Own mirror of a business register.
#   If unset: National authority APIs are used instead; without those,
#   saturation refuses rather than inventing a count.
LANDVEX_REGISTER_URL=

# How many tasks will run behind the load balancer. Read only by
# preflight, to judge the storage choice.
#   If unset: Preflight falls back to WEB_CONCURRENCY, and to 2 if
#   neither is set — because that is what the shipped image runs.
LANDVEX_REPLICAS=3

# PxWeb table for density.
#   If unset: The documented table id is used.
LANDVEX_SCB_DENSITY_TABLE=

# PxWeb table id for Swedish establishments.
#   If unset: The documented table id is used.
LANDVEX_SCB_ESTAB_TABLE=

# PxWeb table for income.
#   If unset: The documented table id is used.
LANDVEX_SCB_INCOME_TABLE=

# PxWeb table for population.
#   If unset: The documented table id is used.
LANDVEX_SCB_POP_TABLE=

# Turn on the in-process ticker that runs due scheduled jobs (POST
# /v1/schedules/run does the same work).
#   If unset: Off. Nothing runs unattended: a background thread that
#   starts because a module was imported, and then orders field missions
#   for a customer, is an expensive surprise. Point EventBridge or cron
#   at the endpoint instead when running more than one instance.
LANDVEX_SCHEDULER=on

# Seconds between ticks when the scheduler is on.
#   If unset: 60 seconds. Values below 5 are raised to 5 — the cadence
#   lives in the job, not in the tick.
LANDVEX_SCHEDULER_INTERVAL_S=60

# EMSC seismic portal (FDSN). No key.
#   If unset: Seismic events rest on the USGS catalogue alone.
LANDVEX_SEISMIC_EMSC_URL=https://www.seismicportal.eu

# USGS FDSN base. No key required.
#   If unset: Seismic events are not read.
LANDVEX_SEISMIC_URL=https://earthquake.usgs.gov

# Statistics Norway PxWeb base.
#   If unset: The documented base is used.
LANDVEX_SSB_BASE=

# SSB establishments table.
#   If unset: The documented table id is used.
LANDVEX_SSB_ESTAB_TABLE=

# Statistics Finland base.
#   If unset: The documented base is used.
LANDVEX_STATFIN_BASE=

# StatFin table id.
#   If unset: The documented table id is used.
LANDVEX_STATFIN_ESTAB_TABLE=

# Svenska kraftnät / ENTSO-E grid telemetry.
#   If unset: Grid production mix and balance are mock.
LANDVEX_SVK_URL=

# Station id for the Digitraffic road probe.
#   If unset: The probe uses a documented default station.
LANDVEX_TRAFFIC_FI_STATION=

# Digitraffic road (Finland). No key required.
#   If unset: The SECOND independent road network is missing, so road
#   flow cannot be corroborated.
LANDVEX_TRAFFIC_FI_URL=https://tie.digitraffic.fi

# Trafikverket authentication key (free).
#   If unset: No call is made even if the URL is set — there is no way
#   in without it.
#   SECRET — inject from a secret store.
LANDVEX_TRAFFIC_KEY=

# Trafikverket TrafficFlow endpoint.
#   If unset: Road flow is not measured at all. traffic_shift then rests
#   on one network instead of two.
LANDVEX_TRAFFIC_URL=https://api.trafikinfo.trafikverket.se/v2/data.json

# Station id the weather probe checks.
#   If unset: The probe uses a documented default station.
LANDVEX_WEATHER_STATION=

# SMHI metobs base. No key required.
#   If unset: Weather cannot be used to rule out a cause for an anomaly.
LANDVEX_WEATHER_URL=https://opendata-download-metobs.smhi.se

# Station id for the NWS weather probe.
#   If unset: The probe uses a documented default station.
LANDVEX_WEATHER_US_STATION=

# NOAA/NWS base. No key required.
#   If unset: The second independent weather network is missing.
LANDVEX_WEATHER_US_URL=https://api.weather.gov

# ────────────────────────────────────────────────────────────────────
# NOT READ BY THE APPLICATION — docker-compose reads these
# ────────────────────────────────────────────────────────────────────

# host:port docker-compose publishes the app on.
#   If unset: Defaults to 127.0.0.1:8000 — reachable from the host, not
#   from the network. Change it deliberately, not by accident.
APP_BIND=127.0.0.1:8000

# Database name for the compose profile.
#   If unset: Defaults to 'landvex'.
PGDATABASE=landvex

# Password for the compose-managed PostgreSQL.
#   If unset: Defaults to 'changeme', which is fine on a laptop and
#   nowhere else. In AWS this database does not exist — Aurora does, and
#   its DSN lives in Secrets Manager.
#   SECRET — inject from a secret store.
PGPASSWORD=

# User for the compose-managed PostgreSQL.
#   If unset: Defaults to 'landvex'.
PGUSER=landvex
